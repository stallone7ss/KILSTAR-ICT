# ==============================================================================
# KILSTAR-ICT — Environment Configurations
# ==============================================================================
# For GitHub Codespaces:
#   1. Copy this file: cp .env.example .env
#   2. Or configure as a GitHub Secret / Codespaces Secret in:
#      Repository Settings -> Secrets and variables -> Codespaces -> "DATABASE_URL"
#
# For Vercel Production / Preview:
#   Add in Vercel Project Dashboard:
#   Settings -> Environment Variables -> "DATABASE_URL" (Target: Production, Preview, Development)
# ==============================================================================

# Neon Serverless Postgres Connection String
# Obtain this from your Neon Console (https://console.neon.tech):
# Dashboard -> Connection Details -> select "Connection string" -> Pooled / Serverless
DATABASE_URL="postgres://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Vercel Environment Context (Populated automatically by Vercel runtime)
# VERCEL_ENV="development" # or "preview" | "production"

# Application Port (for local Node server testing in Codespaces)
PORT=3000
NODE_ENV="development"
